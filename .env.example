# 'gemini' (default), 'openai' o 'fake' (modo offline determinista, sin LLM
# real) — ver ADR 0022 y ADR 0016.
LLM_PROVIDER=gemini

GOOGLE_AI_STUDIO_API_KEY=
GEMINI_MODEL=

# Solo si LLM_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=

JWT_SECRET=cambia-esto-en-produccion
BANK_DB_PATH=banco.db

# Usada al construir la imagen del frontend (docker-compose.yml, servicio
# "frontend"): debe ser una URL alcanzable por el navegador del cliente,
# p.ej. la IP o hostname del homelab en la red local o el tailnet.
VITE_API_BASE_URL=http://localhost:10000
